{
  "name": "turnoya-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply turnoya --local && wrangler d1 execute turnoya --local --file=seed.sql && wrangler d1 execute turnoya --local --file=seed_demo.sql",
    "db:remote": "wrangler d1 migrations apply turnoya --remote",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.1.1",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261113.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
